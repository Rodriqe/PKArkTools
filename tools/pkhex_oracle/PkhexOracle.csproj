<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Oráculo diferencial: carga un save con PKHeX.Core y lo vuelca a JSON para
    compararlo con pkcore (tool/compare_with_pkhex.sh). PKHeX (GPL-3.0) no se
    versiona: se clona en .ref/PKHeX (ver README.md de esta carpeta).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../.ref/PKHeX/PKHeX.Core/PKHeX.Core.csproj" />
  </ItemGroup>

</Project>
